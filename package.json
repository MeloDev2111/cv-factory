{
  "name": "cv-factory",
  "version": "0.1.0",
  "description": "Manage CVs as structured data and render tailored ATS-friendly PDFs.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "cvf": "dist/cli/index.js",
    "cv-factory": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "samples": "node scripts/render-samples.mjs",
    "gen:types": "json2ts -i schema/resume.schema.json -o src/domain/generated/resume.ts && json2ts -i schema/variant.schema.json -o src/domain/generated/variant.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
