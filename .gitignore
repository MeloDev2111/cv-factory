# Dependencies and build artifacts
node_modules/
dist/
# Personal data: only the fictional people (example, showcase) are versioned.
# To publish another person's (public-safe) data, un-ignore that folder
# explicitly, e.g. `!people/jane-doe/`.
people/*
!people/example/
!people/showcase/

# Generated PDFs (people/<person>/output/) can contain personal data: never commit them.
# Only the fictional showcase PDFs are versioned, as samples of what the tool produces
# (regenerate them with `npm run samples` after changing a template).
people/example/output/

